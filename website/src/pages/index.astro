---
import '../styles/landing.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BarkVisor — QEMU Virtualization with a Web Interface</title>
    <meta
      name="description"
      content="Open-source QEMU virtualization for macOS and Linux with a modern web interface. Create, run, and manage virtual machines with ease."
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="BarkVisor — QEMU Virtualization with a Web Interface" />
    <meta
      property="og:description"
      content="Open-source QEMU virtualization for macOS and Linux with a modern web interface."
    />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="BarkVisor — QEMU Virtualization with a Web Interface" />
    <meta
      name="twitter:description"
      content="Open-source QEMU virtualization for macOS and Linux with a modern web interface."
    />
    <meta name="twitter:image" content="/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="nav-brand">
        <img src="/hero.png" alt="BarkVisor" />
        BarkVisor
      </div>
      <button
        class="nav-toggle"
        aria-label="Menu"
        onclick="document.querySelector('.nav-links').classList.toggle('open')"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line
            x1="4"
            y1="18"
            x2="20"
            y2="18"></line></svg
        >
      </button>
      <nav class="nav-links">
        <a href="#features">Features</a>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/pmdroid/barkvisor">GitHub</a>
        <button class="theme-toggle" aria-label="Toggle theme" type="button">
          <svg
            class="icon-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
          >
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line
              x1="12"
              y1="21"
              x2="12"
              y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line
              x1="18.36"
              y1="18.36"
              x2="19.78"
              y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line
              x1="21"
              y1="12"
              x2="23"
              y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line
              x1="18.36"
              y1="5.64"
              x2="19.78"
              y2="4.22"></line></svg
          >
        </button>
      </nav>
    </header>

    <section class="hero">
      <img src="/hero.png" alt="BarkVisor mascot" class="hero-img" />
      <div class="hero-badge">Open Source &middot; macOS &amp; Linux</div>
      <h1>QEMU virtualization,<br /><span>with a modern web interface.</span></h1>
      <p>
        BarkVisor is open-source virtualization software for <strong>macOS</strong> and
        <strong>Linux</strong> that makes it easy to create, run, and manage QEMU virtual machines through
        a beautiful web UI.
      </p>
      <div class="hero-buttons">
        <a href="https://github.com/pmdroid/barkvisor/releases" class="btn btn-primary">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
              points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg
          >
          Download
        </a>
        <a href="/docs/linux/" class="btn btn-ghost">Linux guide</a>
        <a href="https://github.com/pmdroid/barkvisor" class="btn btn-ghost">
          <svg viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M12 .3a12 12 0 0 0-3.8 23.38c.6.1.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6.02 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18a4.65 4.65 0 0 1 1.24 3.22c0 4.61-2.8 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"
            ></path></svg
          >
          View on GitHub
        </a>
      </div>
    </section>

    <section class="features" id="features">
      <div class="features-header">
        <h2>Features</h2>
      </div>
      <p class="features-desc">Everything you need to run virtual machines on macOS and Linux</p>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8"></path><path
                d="M12 17v4"></path></svg
            >
          </div>
          <h3>Web UI</h3>
          <p>
            Manage all your VMs from a clean web interface — headless daemon on macOS and multi-distro
            Linux. No desktop app required.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="3"></circle><path
                d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
              ></path></svg
            >
          </div>
          <h3>Full VM Configuration</h3>
          <p>
            Configure CPU cores, RAM, UEFI boot, TPM 2.0 emulation, and cloud-init provisioning — all
            through the UI.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"
              ></path><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path></svg
            >
          </div>
          <h3>Disk Management</h3>
          <p>
            Create and manage qcow2 and raw disk images with hot-plug support, live resizing, and
            snapshot capabilities.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="2" width="20" height="20" rx="2"></rect><line x1="7" y1="2" x2="7" y2="22"
              ></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"
              ></line></svg
            >
          </div>
          <h3>Console &amp; VNC</h3>
          <p>
            Access your VMs directly in the browser with a built-in serial console (xterm.js) and VNC
            display (noVNC).
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path></svg
            >
          </div>
          <h3>Networking &amp; SSH</h3>
          <p>
            NAT with port forwarding on every host. Bridged networking via socket_vmnet on macOS and host
            bridge + qemu-bridge-helper on Linux. Manage SSH keys and connect in seconds.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8"></path><path
                d="M12 17v4"></path></svg
            >
          </div>
          <h3>macOS &amp; Linux</h3>
          <p>
            Production <code>.pkg</code> on Apple Silicon. Multi-distro Linux packages (<code>.deb</code>,
            <code>.rpm</code>, tarball), systemd, and Docker — Ubuntu, Debian, Arch, Fedora,
            Rocky/Alma/RHEL 10+.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path></svg
            >
          </div>
          <h3>Open Source</h3>
          <p>
            Fully open source and self-hosted. Your VMs stay on your machine — no cloud accounts or
            subscriptions needed.
          </p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="cta-card">
        <h2>Get started in minutes</h2>
        <p>
          Install the macOS package or a Linux <code>.deb</code> / <code>.rpm</code> / tarball, open the
          web UI, and spin up your first VM.
        </p>
        <a href="/docs/" class="btn btn-primary">Read the docs</a>
        <a
          href="https://github.com/pmdroid/barkvisor/releases"
          class="btn btn-ghost"
          style="margin-left: 8px"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="width: 16px; height: 16px"
            ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
              points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg
          >
          Releases
        </a>
      </div>
    </section>

    <footer class="footer">
      <p>
        Made with ❤️ in SF &middot; <a href="/docs/">Docs</a> &middot;
        <a href="https://github.com/pmdroid/barkvisor">GitHub</a>
      </p>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = localStorage.getItem('theme');
        if (stored) {
          root.setAttribute('data-theme', stored);
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          root.setAttribute('data-theme', 'light');
        }
        document.querySelector('.theme-toggle').addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          root.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        });
      })();
    </script>
  </body>
</html>
