---
/**
 * Starlight Head override: keep default head tags and inject PostHog on all docs pages.
 */
import Default from '@astrojs/starlight/components/Head.astro'
import PostHog from './posthog.astro'
const ogImage = new URL('/og-image.png', Astro.site).href
---

<Default {...Astro.props} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="BarkVisor" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="BarkVisor" />
<PostHog />
