<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>homebrew.mxcl.barkvisor</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PROGRAM@</string>
    </array>
    <key>UserName</key>
    <string>_barkvisor</string>
    <key>GroupName</key>
    <string>_barkvisor</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Do not reap QEMU children when launchd restarts the daemon (PAS-223). -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/var/lib/barkvisor</string>
    <key>StandardOutPath</key>
    <string>/var/log/barkvisor/server.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/barkvisor/server.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BARKVISOR_DATA_DIR</key>
        <string>/var/lib/barkvisor</string>
        <key>BARKVISOR_SOCKET_DIR</key>
        <string>/var/run/barkvisor</string>
        <key>PATH</key>
        <string>@HOMEBREW_PREFIX@/bin:@HOMEBREW_PREFIX@/sbin:@HOMEBREW_PREFIX@/opt/socket_vmnet/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
</dict>
</plist>
