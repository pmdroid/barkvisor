<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>homebrew.mxcl.barkvisor-daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PROGRAM@</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/var/lib/barkvisor</string>
    <key>StandardOutPath</key>
    <string>/var/log/barkvisor/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/barkvisor/daemon.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BARKVISOR_DATA_DIR</key>
        <string>/var/lib/barkvisor</string>
        <key>BARKVISOR_SOCKET_DIR</key>
        <string>/var/run/barkvisor</string>
        <key>BARKVISOR_PROCESS_ROLE</key>
        <string>bark-daemon</string>
    </dict>
</dict>
</plist>
