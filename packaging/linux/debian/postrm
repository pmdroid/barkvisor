#!/bin/sh
set -e

case "$1" in
  purge)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl disable barkvisor.service >/dev/null 2>&1 || true
      systemctl disable barkvisor-agent.service >/dev/null 2>&1 || true
      systemctl daemon-reload || true
    fi
    # Keep /var/lib/barkvisor data unless admin purges explicitly via uninstall --purge
    rm -f /etc/barkvisor/barkvisor.env
    rmdir /etc/barkvisor 2>/dev/null || true
    ;;
  remove)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
    fi
    ;;
esac

exit 0
