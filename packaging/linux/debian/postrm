#!/bin/sh
set -e

# Self-contained: package files are already gone when this runs.
# Keep in sync with scripts/lib/tagged-bridge-cleanup.sh
# Tagged bridge.conf / netplan / NM / networkd only. Never drop shared br0.
# dpkg --purge offers bridge removal via BARKVISOR_REMOVE_BRIDGE=1; it never
# defaults it. Appliance data stays at /var/lib/barkvisor.

BARKVISOR_ACL_MARKER="# barkvisor:allow-br0"
BARKVISOR_ACL_MARKER_PREFIX="# barkvisor:allow-"
BARKVISOR_MANAGED_MARKER="# managed-by: barkvisor"

barkvisor_bridge_name() { printf '%s' "${BARKVISOR_BRIDGE:-br0}"; }
barkvisor_host_root() { printf '%s' "${BARKVISOR_HOST_ROOT:-}"; }

barkvisor_acl_path() {
  if [ -n "${BARKVISOR_BRIDGE_ACL:-}" ]; then
    printf '%s' "$BARKVISOR_BRIDGE_ACL"
    return
  fi
  printf '%s/etc/qemu/bridge.conf' "$(barkvisor_host_root)"
}

barkvisor_netplan_dir() {
  if [ -n "${BARKVISOR_NETPLAN_DIR:-}" ]; then
    printf '%s' "$BARKVISOR_NETPLAN_DIR"
    return
  fi
  printf '%s/etc/netplan' "$(barkvisor_host_root)"
}

barkvisor_networkd_dir() {
  if [ -n "${BARKVISOR_NETWORKD_DIR:-}" ]; then
    printf '%s' "$BARKVISOR_NETWORKD_DIR"
    return
  fi
  printf '%s/etc/systemd/network' "$(barkvisor_host_root)"
}

barkvisor_nm_dir() {
  if [ -n "${BARKVISOR_NM_DIR:-}" ]; then
    printf '%s' "$BARKVISOR_NM_DIR"
    return
  fi
  printf '%s/etc/NetworkManager/system-connections' "$(barkvisor_host_root)"
}

barkvisor_data_dir() {
  if [ -n "${BARKVISOR_DATA_DIR:-}" ]; then
    printf '%s' "$BARKVISOR_DATA_DIR"
    return
  fi
  printf '%s/var/lib/barkvisor' "$(barkvisor_host_root)"
}

barkvisor_file_is_tagged() {
  [ -f "$1" ] || return 1
  grep -q "^${BARKVISOR_MANAGED_MARKER}$" "$1"
}

barkvisor_name_is_ours() {
  case "$(basename "$1")" in
    90-barkvisor-*|barkvisor-*) return 0 ;;
    *) return 1 ;;
  esac
}

barkvisor_strip_tagged_acl() {
  acl="$(barkvisor_acl_path)"
  [ -f "$acl" ] || return 0
  tmp="${acl}.barkvisor-strip.$$"
  awk -v prefix="$BARKVISOR_ACL_MARKER_PREFIX" '
    index($0, prefix)==1 { skip=1; next }
    skip==1 && $0 ~ /^allow / { skip=0; next }
    { skip=0; print }
  ' "$acl" >"$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$acl"
}

barkvisor_remove_tagged_in_dir() {
  dir="$1"
  [ -d "$dir" ] || return 0
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    if barkvisor_file_is_tagged "$f" || barkvisor_name_is_ours "$f"; then
      rm -f "$f"
    fi
  done
}

barkvisor_remove_tagged_host_files() {
  barkvisor_remove_tagged_in_dir "$(barkvisor_netplan_dir)"
  barkvisor_remove_tagged_in_dir "$(barkvisor_networkd_dir)"
  barkvisor_remove_tagged_in_dir "$(barkvisor_nm_dir)"
  data="$(barkvisor_data_dir)"
  if [ -d "$data" ]; then
    for marker in "$data"/host-bridge-*.json; do
      [ -f "$marker" ] || continue
      base="$(basename "$marker")"
      name="${base#host-bridge-}"
      name="${name%.json}"
      [ -n "$name" ] || continue
      rm -f "$(barkvisor_netplan_dir)/90-barkvisor-${name}.yaml"
      rm -f "$(barkvisor_networkd_dir)/90-barkvisor-${name}.netdev"
      rm -f "$(barkvisor_networkd_dir)/90-barkvisor-${name}.network"
      if command -v nmcli >/dev/null 2>&1 && [ -z "${BARKVISOR_SKIP_NMCLI:-}" ]; then
        nmcli connection delete "barkvisor-${name}" >/dev/null 2>&1 || true
      fi
      rm -f "$marker"
    done
  fi
  bridge="$(barkvisor_bridge_name)"
  rm -f "$(barkvisor_netplan_dir)/90-barkvisor-${bridge}.yaml"
  rm -f "$(barkvisor_networkd_dir)/90-barkvisor-${bridge}.netdev"
  rm -f "$(barkvisor_networkd_dir)/90-barkvisor-${bridge}.network"
  if command -v nmcli >/dev/null 2>&1 && [ -z "${BARKVISOR_SKIP_NMCLI:-}" ]; then
    nmcli connection delete "barkvisor-${bridge}" >/dev/null 2>&1 || true
  fi
  rm -f "$(barkvisor_data_dir)/host-bridge-${bridge}.json"
}

barkvisor_offer_bridge_removal() {
  bridge="$(barkvisor_bridge_name)"
  echo "Tagged BarkVisor files were removed. ${bridge} was left in place (shared bridges are never default-deleted)."
  echo "To also delete a BarkVisor-created ${bridge}, set BARKVISOR_REMOVE_BRIDGE=1 (only if we created it)."
}

barkvisor_maybe_remove_bridge() {
  bridge="$(barkvisor_bridge_name)"
  if [ "${BARKVISOR_REMOVE_BRIDGE:-0}" != "1" ]; then
    return 0
  fi
  marker="$(barkvisor_data_dir)/host-bridge-${bridge}.json"
  created=0
  if [ "${BARKVISOR_BRIDGE_CREATED:-}" = "1" ]; then
    created=1
  elif [ -f "$marker" ] && grep -q '"createdBridge"[[:space:]]*:[[:space:]]*true' "$marker"; then
    created=1
  fi
  if [ "$created" != "1" ]; then
    echo "error: no BarkVisor created-bridge marker for ${bridge}. Will not delete a shared bridge." >&2
    return 5
  fi
  if [ "${BARKVISOR_DRY_RUN:-0}" = "1" ]; then
    echo "dry-run: would ip link delete ${bridge}"
    return 0
  fi
  if command -v ip >/dev/null 2>&1; then
    ip link delete "$bridge" >/dev/null 2>&1 || true
  fi
}

barkvisor_cleanup_tagged_bridge() {
  # Snapshot created-bridge before the marker file is removed.
  if [ -z "${BARKVISOR_BRIDGE_CREATED:-}" ]; then
    marker="$(barkvisor_data_dir)/host-bridge-$(barkvisor_bridge_name).json"
    if [ -f "$marker" ] && grep -q '"createdBridge"[[:space:]]*:[[:space:]]*true' "$marker"; then
      BARKVISOR_BRIDGE_CREATED=1
    fi
  fi
  barkvisor_strip_tagged_acl
  barkvisor_remove_tagged_host_files
}

case "$1" in
  remove|purge)
    barkvisor_cleanup_tagged_bridge
    if command -v systemctl >/dev/null 2>&1 && [ -z "${BARKVISOR_HOST_ROOT:-}" ]; then
      if [ "$1" = purge ]; then
        systemctl disable barkvisor.service >/dev/null 2>&1 || true
        systemctl disable barkvisor-agent.service >/dev/null 2>&1 || true
      fi
      systemctl daemon-reload || true
    fi
    if [ "$1" = purge ]; then
      rm -f "$(barkvisor_host_root)/etc/barkvisor/barkvisor.env"
      rmdir "$(barkvisor_host_root)/etc/barkvisor" 2>/dev/null || true
      # Keep /var/lib/barkvisor unless the operator uses uninstall.sh --purge
      barkvisor_offer_bridge_removal
    fi
    barkvisor_maybe_remove_bridge
    ;;
esac

exit 0
