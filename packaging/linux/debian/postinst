#!/bin/sh
set -e

DATA_DIR=/var/lib/barkvisor
RUN_DIR=/var/run/barkvisor

case "$1" in
  configure)
    if ! getent passwd barkvisor >/dev/null 2>&1; then
      useradd --system --home "$DATA_DIR" --shell /usr/sbin/nologin barkvisor 2>/dev/null \
        || useradd --system --home "$DATA_DIR" --shell /bin/false barkvisor
    fi
    if getent group kvm >/dev/null 2>&1; then
      usermod -aG kvm barkvisor 2>/dev/null || true
    fi
    if getent group vfio >/dev/null 2>&1; then
      usermod -aG vfio barkvisor 2>/dev/null || true
    fi
    if getent group disk >/dev/null 2>&1; then
      usermod -aG disk barkvisor 2>/dev/null || true
      for unit in barkvisor.service barkvisor-agent.service; do
        mkdir -p /etc/systemd/system/${unit}.d
        printf '%s\n' '[Service]' 'SupplementaryGroups=disk' \
          >/etc/systemd/system/${unit}.d/disk.conf
      done
    fi
    install -d -o barkvisor -g barkvisor -m 0755 "$DATA_DIR" "$RUN_DIR"
    # Apply writes /etc/qemu/bridge.conf. The dir must exist before the unit
    # starts or systemd ignores ReadWritePaths=-/etc/qemu (ProtectSystem=strict).
    install -d -m 0755 /etc/qemu
    if command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload || true
      udevadm trigger --subsystem-match=vfio || true
    fi
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
      if [ -z "${BARKVISOR_SKIP_ENABLE:-}" ]; then
        systemctl enable barkvisor.service >/dev/null 2>&1 || true
      fi
      systemctl try-restart barkvisor.service >/dev/null 2>&1 || true
      systemctl try-restart barkvisor-agent.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
