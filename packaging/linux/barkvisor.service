[Unit]
Description=BarkVisor QEMU management daemon
Documentation=https://github.com/pmdroid/barkvisor
After=network-online.target
Wants=network-online.target
Conflicts=barkvisor-agent.service

[Service]
Type=simple
User=root
Group=barkvisor
WorkingDirectory=/var/lib/barkvisor
Environment=HOME=/var/lib/barkvisor
Environment=BARKVISOR_DATA_DIR=/var/lib/barkvisor
Environment=BARKVISOR_SOCKET_DIR=/var/run/barkvisor
Environment=BARKVISOR_PORT=7777
Environment=LD_LIBRARY_PATH=/usr/local/lib/barkvisor/swift:/usr/local/lib/barkvisor/compat
EnvironmentFile=-/etc/barkvisor/barkvisor.env
ExecStart=/usr/local/bin/barkvisor
Restart=on-failure
RestartSec=3
# Only signal the daemon. Default control-group would SIGTERM QEMU children
# on restart and stop Workloads (PAS-223). detachAll + reconnectOrCleanup
# reattach after the new PID is up.
KillMode=process
# Recreate /run/barkvisor after reboot (/run is tmpfs). Preserve=yes keeps
# QEMU sockets across daemon restart so reconnectOrCleanup can reattach.
# 0770 + Group=barkvisor so dropped QEMU can create sockets.
RuntimeDirectory=barkvisor
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
# Ubuntu qemu packages often omit /etc/qemu. Create it at start so
# ReadWritePaths=-/etc/qemu is not ignored under ProtectSystem=strict.
ConfigurationDirectory=qemu
# QEMU bridged networking launches setuid qemu-bridge-helper. NoNewPrivileges=true
# blocks that privilege transition, so bridged VMs fail under systemd while NAT works.
# Keep other sandboxing; do not re-enable NoNewPrivileges without an alternate bridge path.
NoNewPrivileges=false
# Daemon is root. kvm/disk on the barkvisor user are for the dropped QEMU process.
SupplementaryGroups=kvm
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Optional host-net apply paths (#378). Dash prefix: missing dirs do not fail the unit.
ReadWritePaths=/var/lib/barkvisor /var/run/barkvisor -/etc/netplan -/etc/NetworkManager -/etc/qemu -/etc/systemd/network -/usr/lib/qemu/qemu-bridge-helper -/usr/libexec/qemu-bridge-helper -/usr/local/libexec/qemu/qemu-bridge-helper
ReadOnlyPaths=/usr/local/share/barkvisor /usr/local/lib/barkvisor
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
