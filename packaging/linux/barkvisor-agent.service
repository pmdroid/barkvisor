[Unit]
Description=BarkVisor API-only Device daemon
Documentation=https://github.com/pmdroid/barkvisor
After=network-online.target
Wants=network-online.target
Conflicts=barkvisor.service

[Service]
Type=simple
User=root
Group=barkvisor
WorkingDirectory=/var/lib/barkvisor
Environment=HOME=/var/lib/barkvisor
Environment=BARKVISOR_DATA_DIR=/var/lib/barkvisor
Environment=BARKVISOR_SOCKET_DIR=/var/run/barkvisor
Environment=BARKVISOR_PORT=7777
Environment=LD_LIBRARY_PATH=/usr/local/lib/barkvisor/swift:/usr/local/lib/barkvisor/compat
EnvironmentFile=-/etc/barkvisor/barkvisor.env
ExecStart=/usr/local/bin/barkvisor-agent
Restart=on-failure
RestartSec=3
KillMode=process
RuntimeDirectory=barkvisor
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
# Ubuntu qemu packages often omit /etc/qemu. Create it at start so
# ReadWritePaths=-/etc/qemu is not ignored under ProtectSystem=strict.
ConfigurationDirectory=qemu
# 0007 + Group=barkvisor so qemu-img disks and TPM dirs are group-writable
# after QEMU drops. Copied NVRAM still needs WorkloadPrivilegeDrop.handoff.
UMask=0007
NoNewPrivileges=false
SupplementaryGroups=kvm
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/barkvisor /var/run/barkvisor -/etc/netplan -/etc/NetworkManager -/etc/qemu -/etc/systemd/network -/usr/lib/qemu/qemu-bridge-helper -/usr/libexec/qemu-bridge-helper -/usr/local/libexec/qemu/qemu-bridge-helper
ReadOnlyPaths=/usr/local/share/barkvisor /usr/local/lib/barkvisor
LimitNOFILE=65536
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
