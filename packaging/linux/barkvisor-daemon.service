[Unit]
Description=BarkDaemon local management
Documentation=https://github.com/pmdroid/barkvisor
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
Group=barkvisor
WorkingDirectory=/var/lib/barkvisor
Environment=HOME=/var/lib/barkvisor
Environment=BARKVISOR_DATA_DIR=/var/lib/barkvisor
Environment=BARKVISOR_SOCKET_DIR=/var/run/barkvisor
Environment=BARKVISOR_PROCESS_ROLE=bark-daemon
Environment=LD_LIBRARY_PATH=/usr/local/lib/barkvisor/swift:/usr/local/lib/barkvisor/compat
EnvironmentFile=-/etc/barkvisor/barkvisor.env
ExecStartPre=/usr/local/libexec/barkvisor/install-vfio-udev.sh
ExecStart=/usr/local/bin/barkvisor daemon
Restart=on-failure
RestartSec=3
KillMode=process
RuntimeDirectory=barkvisor
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
ConfigurationDirectory=qemu
UMask=0007
NoNewPrivileges=false
SupplementaryGroups=kvm
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/barkvisor /var/run/barkvisor -/run/docker.sock -/var/run/docker.sock -/etc/netplan -/etc/NetworkManager -/etc/qemu -/etc/systemd/network -/usr/lib/qemu/qemu-bridge-helper -/usr/libexec/qemu-bridge-helper -/usr/local/libexec/qemu/qemu-bridge-helper
ReadWritePaths=/usr/local /var/lib/dpkg /var/cache/apt /var/lib/apt /var/cache/debconf /var/log/apt -/var/log/dpkg.log /usr/lib/systemd/system /etc/barkvisor -/etc/systemd/system -/usr/lib/udev/rules.d -/etc/udev/rules.d -/run/needrestart
LimitNOFILE=65536
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
