# BarkVisor daemon environment (systemd EnvironmentFile)
BARKVISOR_PORT=7777
BARKVISOR_DATA_DIR=/var/lib/barkvisor
HOME=/var/lib/barkvisor
# Bundled Swift runtime + optional SONAME shims (libxml2 / ncurses on newer hosts).
LD_LIBRARY_PATH=/usr/local/lib/barkvisor/swift:/usr/local/lib/barkvisor/compat
# SPA is resolved via Config.frontendDir when installed under /usr/local.
# BARKVISOR_FRONTEND_DIR=/usr/local/share/barkvisor/frontend/dist
# Optional first-boot join (pairing offer from the other Device). Ignored after setup.
# BARKVISOR_JOIN_CODE=
