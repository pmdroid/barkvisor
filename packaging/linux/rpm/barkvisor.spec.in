Name:           barkvisor
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Headless QEMU VM manager with web UI
License:        MIT
URL:            https://github.com/pmdroid/barkvisor
# Binary package: payload is prebuilt into the RPM root (no Source0 rebuild).
BuildArch:      @RPM_ARCH@
AutoReqProv:    no

Requires:       ca-certificates
# Guest runtime — hard requirements (not optional recommends)
Requires:       qemu-img
Requires:       qemu-kvm
Requires:       edk2-ovmf
Requires:       genisoimage
Requires:       xorriso
Requires:       usbutils

%description
BarkVisor is a headless daemon for managing QEMU virtual machines through a
browser UI. Supports NAT and bridged networking, cloud images, cloud-init,
serial console, and VNC on Linux arm64 and amd64 hosts.

This package installs the daemon under /usr/local, a systemd unit, and a
default environment file. QEMU, UEFI firmware, ISO tools, and usbutils are
required dependencies from the distro.

%install
mkdir -p %{buildroot}
cp -a %{_sourcedir}/root/. %{buildroot}/

%files
%defattr(-,root,root,-)
/usr/local/bin/barkvisor
/usr/local/bin/barkvisor-agent
/usr/local/bin/BarkVisor_BarkVisorCore.resources
/usr/local/share/barkvisor
/usr/local/lib/barkvisor
/usr/lib/systemd/system/barkvisor.service
/usr/lib/systemd/system/barkvisor-daemon.service
/usr/lib/systemd/system/barkvisor-server.service
/usr/lib/systemd/system/barkvisor-agent.service
/usr/local/libexec/barkvisor/install-vfio-udev.sh
%config(noreplace) /etc/barkvisor/barkvisor.env
%dir /etc/qemu

%pre
getent passwd barkvisor >/dev/null 2>&1 || \
  useradd --system --home /var/lib/barkvisor --shell /sbin/nologin barkvisor 2>/dev/null || \
  useradd --system --home /var/lib/barkvisor --shell /bin/false barkvisor
getent group kvm >/dev/null 2>&1 && usermod -aG kvm barkvisor 2>/dev/null || true
getent group vfio >/dev/null 2>&1 && usermod -aG vfio barkvisor 2>/dev/null || true
getent group disk >/dev/null 2>&1 && usermod -aG disk barkvisor 2>/dev/null || true
exit 0

%post
stop_combined_listener() {
  main_pid="$(systemctl show -p MainPID --value barkvisor.service 2>/dev/null || true)"
  pid=$$
  while [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "1" ]; do
    if [ -n "$main_pid" ] && [ "$pid" = "$main_pid" ]; then
      systemd-run --collect --unit="barkvisor-split-$$" /bin/sh -c '
        while [ -e "/proc/$1" ]; do sleep 1; done
        systemctl stop barkvisor.service || exit 1
        if ! systemctl restart barkvisor-daemon.service barkvisor-server.service ||
           ! systemctl is-active --quiet barkvisor-daemon.service ||
           ! systemctl is-active --quiet barkvisor-server.service; then
          systemctl stop barkvisor-daemon.service barkvisor-server.service >/dev/null 2>&1 || true
          systemctl enable barkvisor.service >/dev/null 2>&1 || true
          systemctl start barkvisor.service
          exit 1
        fi
      ' sh "$$" >/dev/null || return 1
      systemctl disable barkvisor.service >/dev/null 2>&1 || true
      return 0
    fi
    pid="$(awk '/^PPid:/ { print $2; exit }' "/proc/${pid}/status" 2>/dev/null || true)"
  done
  systemctl disable --now barkvisor.service >/dev/null 2>&1 || true
}
schema_file=/var/lib/barkvisor/schema-version
if [ -f "$schema_file" ]; then
  on_disk=$(tr -cd '0-9' < "$schema_file" || true)
  if [ -n "$on_disk" ] && [ "$on_disk" -gt 1 ]; then
    echo "unsupported downgrade: schema $on_disk" >&2
    exit 1
  fi
fi
install -d -o barkvisor -g barkvisor -m 0755 /var/lib/barkvisor /var/run/barkvisor
if [ ! -f "$schema_file" ]; then
  printf '1\n' > "$schema_file"
  chown barkvisor:barkvisor "$schema_file" 2>/dev/null || true
fi
install -d -m 0755 /etc/qemu
if getent group disk >/dev/null 2>&1; then
  for unit in barkvisor-daemon.service barkvisor-agent.service; do
    mkdir -p /etc/systemd/system/${unit}.d
    printf '%s\n' '[Service]' 'SupplementaryGroups=disk' \
      >/etc/systemd/system/${unit}.d/disk.conf
  done
fi
if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload || true
  udevadm trigger --subsystem-match=vfio || true
fi
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  stop_combined_listener || exit 1
  systemctl enable barkvisor-daemon.service >/dev/null 2>&1 || true
  systemctl enable barkvisor-server.service >/dev/null 2>&1 || true
  systemctl try-restart barkvisor-daemon.service >/dev/null 2>&1 || true
  systemctl try-restart barkvisor-server.service >/dev/null 2>&1 || true
  systemctl start barkvisor-daemon.service >/dev/null 2>&1 || true
  systemctl start barkvisor-server.service >/dev/null 2>&1 || true
  systemctl try-restart barkvisor-agent.service >/dev/null 2>&1 || true
fi
exit 0

%preun
if [ "$1" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
  systemctl stop barkvisor.service >/dev/null 2>&1 || true
  systemctl disable barkvisor.service >/dev/null 2>&1 || true
  systemctl stop barkvisor-daemon.service >/dev/null 2>&1 || true
  systemctl disable barkvisor-daemon.service >/dev/null 2>&1 || true
  systemctl stop barkvisor-server.service >/dev/null 2>&1 || true
  systemctl disable barkvisor-server.service >/dev/null 2>&1 || true
  systemctl stop barkvisor-agent.service >/dev/null 2>&1 || true
  systemctl disable barkvisor-agent.service >/dev/null 2>&1 || true
fi
exit 0

%postun
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi
exit 0

%changelog
* @CHANGELOG_DATE@ BarkVisor Contributors <noreply@barkvisor.dev> - @VERSION@-1
- Packaged BarkVisor @VERSION@ for Linux multi-distro hosts.
