[Unit]
Description=BarkVisor QEMU management daemon
Documentation=https://github.com/pmdroid/barkvisor
Documentation=file:///usr/local/share/barkvisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barkvisor
Group=barkvisor
WorkingDirectory=/var/lib/barkvisor
# Defaults; override in /etc/barkvisor/barkvisor.env
Environment=HOME=/var/lib/barkvisor
Environment=BARKVISOR_DATA_DIR=/var/lib/barkvisor
Environment=BARKVISOR_SOCKET_DIR=/var/run/barkvisor
Environment=BARKVISOR_PORT=7777
# SONAME shims for hosts newer than the Swift LTS toolchain (e.g. Ubuntu 26.04).
Environment=LD_LIBRARY_PATH=/usr/local/lib/barkvisor/compat
EnvironmentFile=-/etc/barkvisor/barkvisor.env
# Binary under /usr/local/bin so Config.prefix=/usr/local and SPA is
# /usr/local/share/barkvisor/frontend/dist (see install-linux.sh).
ExecStart=/usr/local/bin/barkvisor
Restart=on-failure
RestartSec=3
# Only signal the daemon. Default control-group would SIGTERM QEMU children
# on restart and stop Workloads (PAS-223). detachAll + reconnectOrCleanup
# reattach after the new PID is up.
KillMode=process
# Recreate /run/barkvisor after reboot (/run is tmpfs). Preserve=yes keeps
# QEMU sockets across daemon restart so reconnectOrCleanup can reattach.
RuntimeDirectory=barkvisor
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# QEMU bridged networking launches setuid qemu-bridge-helper. NoNewPrivileges=true
# blocks that privilege transition, so bridged VMs fail under systemd while NAT works.
# Keep other sandboxing; do not re-enable NoNewPrivileges without an alternate bridge path.
NoNewPrivileges=false
# kvm = /dev/kvm. disk = raw host block devices (/dev/sdX). systemd replaces
# the user's supplementary groups with this list (usermod alone is not enough).
SupplementaryGroups=kvm disk
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/barkvisor /var/run/barkvisor
# Allow reading the installed SPA + optional custom frontend dir + compat libs
ReadOnlyPaths=/usr/local/share/barkvisor /usr/local/lib/barkvisor
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
