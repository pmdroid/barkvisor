<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.barkvisor.server</string>
    <key>UserName</key>
    <string>barkvisor</string>
    <key>GroupName</key>
    <string>barkvisor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/barkvisor</string>
        <string>server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/var/lib/barkvisor</string>
    <key>StandardOutPath</key>
    <string>/var/log/barkvisor/server-public.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/barkvisor/server-public.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BARKVISOR_SERVICE_NAME</key>
        <string>BarkServer</string>
        <key>BARKVISOR_DATA_DIR</key>
        <string>/var/lib/barkvisor</string>
        <key>BARKVISOR_SOCKET_DIR</key>
        <string>/var/run/barkvisor</string>
        <key>BARKVISOR_PROCESS_ROLE</key>
        <string>bark-server</string>
    </dict>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
</dict>
</plist>
